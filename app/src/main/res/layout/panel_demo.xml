<?xml version="1.0" encoding="utf-8"?>
<!-- 시연·개발용 패널. 시나리오 재생, 실제 차량 신호 토글, 신호 값, 판정 기록. 주행 화면에는 넣지 않는다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="match_parent"
    android:background="@color/panel"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/demo_title"
        android:textColor="@color/text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/demo_subtitle"
        android:textColor="@color/muted"
        android:textSize="18sp" />

    <!-- 내비가 앞에 있을 때 어떤 방식으로 안내하는지 (겹침 창 카드 / 상단 알림) -->
    <TextView
        android:id="@+id/demoNotifier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/text"
        android:textSize="18sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/scenarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/DemoHeader"
                android:text="@string/demo_signals" />

            <GridLayout
                android:id="@+id/tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2" />

            <TextView
                style="@style/DemoHeader"
                android:text="@string/demo_logs" />

            <TextView
                android:id="@+id/logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text"
                android:textSize="20sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
