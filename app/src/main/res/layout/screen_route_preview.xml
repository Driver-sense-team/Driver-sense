<?xml version="1.0" encoding="utf-8"?>
<!--
  경로 미리보기 (출발 전, 기어 P에서만). 내비에서 목적지를 찍으면 보여준다.
  보통 내비의 경로 요약처럼 만든다.
  위: 목적지 이름.
  가운데 카드: 예상 소요 시간(큰 숫자) + 거리 · 도착 예정 시각.
  그 아래 한 줄: 이 길에서 코치할 곳 수와 자주 놓친 유형.
  아래: "기어를 D로 바꾸면 코치를 시작해요" 또는 경로 데모의 "출발".
  배경(둥근 모서리)은 RoutePreviewScreen.kt에서 Ui.kt 헬퍼로 칠한다. 누를 것은 경로 데모의 "출발" 하나뿐이다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/routePreviewScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/kk_screen_padding"
    android:visibility="gone">

    <TextView
        style="@style/Kk.Caption"
        android:text="@string/route_preview_title" />

    <TextView
        android:id="@+id/routeDestination"
        style="@style/Kk.Title"
        android:layout_marginTop="4dp" />

    <!-- 소요 시간 · 거리 · 도착 시각 -->
    <LinearLayout
        android:id="@+id/routeSummaryCard"
        style="@style/Kk.Card"
        android:layout_marginTop="@dimen/kk_gap_large">

        <TextView
            android:id="@+id/routeDuration"
            style="@style/Kk.Display"
            android:textColor="@color/ok" />

        <TextView
            android:id="@+id/routeDistanceEta"
            style="@style/Kk.Body"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- 이 길에서 코치할 곳 한 줄 -->
    <TextView
        android:id="@+id/routeCoachLine"
        style="@style/Kk.Body"
        android:layout_marginTop="@dimen/kk_gap" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/routePreviewHint"
        style="@style/Kk.Caption"
        android:text="@string/route_preview_hint" />

    <!-- 경로 데모: 출발 전 미리보기에서 누르면 기어 D로 출발한다. 실제 내비 경로에서는 숨기고 기어로 출발한다. -->
    <TextView
        android:id="@+id/routeDepart"
        style="@style/Kk.Pill"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="@dimen/kk_gap"
        android:gravity="center"
        android:text="@string/route_preview_depart"
        android:textColor="@color/on_accent"
        android:textSize="@dimen/kk_text_body"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
