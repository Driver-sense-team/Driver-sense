<?xml version="1.0" encoding="utf-8"?>
<!--
  리포트 요약 수치 카드 한 장 (지킴 / 놓침 / 아낀 범칙금). screen_report.xml에서 세 번 include 한다.
  위: 기호 동그라미(✓ ! ₩) + 라벨. 가운데: 숫자(크게) + 단위(작게). 아래: 보조 설명.
  세 카드 모두 같은 틀이라 숫자와 라벨 줄이 가로로 맞는다. 글자·색은 ReportScreen.kt에서 채운다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:paddingVertical="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 색만으로 구분하지 않게 기호를 같이 쓴다 -->
        <TextView
            android:id="@+id/statIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textSize="@dimen/kk_text_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statLabel"
            style="@style/Kk.Caption"
            android:layout_marginStart="14dp"
            android:textColor="@color/text"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- "3만 원", "1 번": numberEmphasis로 숫자 크게, 단위 작게 -->
    <TextView
        android:id="@+id/statValue"
        style="@style/Kk.Display"
        android:layout_marginTop="20dp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/statCaption"
        style="@style/Kk.Caption"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/muted" />
</LinearLayout>
