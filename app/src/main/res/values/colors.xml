<resources>
    <!--
      밝은 테마 (앱 전체). 화면 파일은 이 이름만 쓰므로 여기 값만 바꾸면 모든 화면이 함께 바뀐다.
      대비는 WCAG 기준으로 계산했다. 글자는 흰 카드와 bg 위 모두 4.5:1 이상.
    -->

    <!-- 배경 단계: bg(화면) < surface(카드) < surface_2(카드 안 칸). 흰 카드가 bg와 구분되게 bg는 옅은 회색. -->
    <color name="bg">#EBEEF2</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_2">#EEF1F5</color>
    <color name="line">#D5DBE3</color>
    <color name="text">#151A21</color>         <!-- 흰 카드 대비 17.5:1 -->
    <color name="muted">#566173</color>        <!-- 흰 카드 6.3:1, bg 5.4:1 -->

    <!--
      상태 색. 색 = 의미: 주황 = 해야 할 일, 파랑 = 지킴, 빨강 = 놓침(정차 화면에서만).
      글자색으로도, 흰 글자(on_accent)를 얹는 카드 바탕으로도 쓰므로 흰색과 4.5:1 이상인 진한 색을 고른다.
    -->
    <color name="warn">#A85400</color>         <!-- 흰색 대비 5.3:1 -->
    <color name="ok">#1F5FD1</color>           <!-- 흰색 대비 5.8:1 -->
    <color name="miss">#C02B2B</color>         <!-- 흰색 대비 5.8:1 -->
    <!-- 상태 색을 옅게 깐 칸(칩, 아이콘 배경). 위에 상태 색 글자를 얹어도 4.5:1 이상. -->
    <color name="warn_soft">#FDF1DE</color>
    <color name="ok_soft">#E7EFFC</color>
    <color name="miss_soft">#FBE9E9</color>
    <!-- 상태 색 바탕(주황·파랑 카드, 버튼) 위 글자 -->
    <color name="on_accent">#FFFFFF</color>

    <!--
      코치 카드·내비 위 팝업 (흰 카드). 흰 바탕에 검정 글자, 상태는 굵은 색 테두리와 색 채움으로 보여준다.
    -->
    <color name="card_light">#FFFFFF</color>
    <color name="card_light_2">#EEF1F4</color>   <!-- 흰 카드 안 칸 (대기 중 그림 원) -->
    <color name="card_light_line">#DDE2E8</color>
    <color name="ink_strong">#111418</color>     <!-- 흰 카드 위 큰 글자 -->
    <color name="ink_soft">#5D6673</color>       <!-- 흰 카드 위 보조 글자, 단위 -->
    <!-- 흰 바탕에서 또렷한 진한 상태 색. 카드 테두리, 꺼진 깜빡이 화살표에 쓴다. -->
    <color name="warn_deep">#F2A700</color>
    <color name="ok_deep">#2F6FE4</color>
    <color name="miss_deep">#E54848</color>
    <!-- 신호등 그림의 불빛. 실제 신호등처럼 켜진 칸만 색, 나머지는 꺼진 회색. 몸통은 ink_strong. -->
    <color name="lamp_red">#FF3B30</color>
    <color name="lamp_yellow">#FFC400</color>
    <color name="lamp_green">#22C55E</color>
    <color name="lamp_off">#4A525E</color>
    <!-- 내비 지도 위 팝업 바탕: 흰색 95%. -->
    <color name="popup_light">#F2FFFFFF</color>
    <!--
      코치 카드·내비 위 팝업 전용 상태 색. 앱 전체(밝은 테마)의 진한 warn/ok/miss와 따로 둔다.
      카드 채움과 방향 원에만 쓰고, 그 위 글자는 ink_strong(검정)이라 밝은 색이어도 잘 읽힌다.
    -->
    <color name="coach_warn">#FFC04D</color>
    <color name="coach_ok">#4C8DFF</color>
    <color name="coach_miss">#FF6B6B</color>

    <!-- 데모 패널 전용. 주행 상태 색(warn, ok)과 겹치지 않게 따로 둔다. -->
    <color name="panel">#E2E7ED</color>
    <color name="demo_active">#C3CCD8</color>
</resources>
